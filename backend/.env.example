# ARQAU backend — example environment file.
#
# Copy to backend/.env and fill in real values:
#     cp .env.example .env
#
# backend/.env is gitignored. NEVER commit a filled-in copy of this file.
# Every value below is a placeholder.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# development | testing | production
# In production the app refuses to start unless SECRET_KEY, a PostgreSQL
# DATABASE_URL, and OPENAI_API_KEY are all set to real values.
APP_ENV=development

# JWT signing secret. Must be a long random value in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not reuse this placeholder outside local development.
SECRET_KEY=replace-me-with-a-long-random-value

# Database URL. SQLite is used for local development only.
#   SQLite:     sqlite+aiosqlite:///./arqau.db
#   PostgreSQL: postgresql://user:password@host:5432/arqau
#               (a postgres:// prefix is normalised to postgresql+asyncpg://)
DATABASE_URL=sqlite+aiosqlite:///./arqau.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider (Phase 3.3 / Phase 3.4)
# ---------------------------------------------------------------------------

# OpenAI (or OpenRouter) API key.
# An OpenRouter key is detected by its "sk-or-" prefix and automatically
# routed to https://openrouter.ai/api/v1.
# If unset, the AI endpoints still work: they return the deterministic,
# server-owned fallback response instead of calling the provider.
OPENAI_API_KEY=replace-me-with-your-openai-or-openrouter-key

# Chat model used for the decision layer and the copilot.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# JWT signing algorithm. Only HS256 is supported by the current token code.
ALGORITHM=HS256

# Access token lifetime in minutes. Short-lived access tokens are intended;
# renewal is handled by the rotating refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# Testing / development notes
# ---------------------------------------------------------------------------
# Tests set APP_ENV/SECRET_KEY/OPENAI_API_KEY themselves and run against
# throwaway SQLite databases; see backend/pytest.ini and backend/tests/.
# These values are only relevant when running the app locally:
#
#   APP_ENV=development       create_all() runs at startup
#   APP_ENV=testing           no startup DDL; deterministic secrets
#
# No environment variable is needed for rate limiting or AI timeouts yet;
# those arrive with Phase 3.5.1 / 3.5.2.
